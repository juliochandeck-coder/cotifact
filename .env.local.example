# Copia este archivo a .env.local y rellena con tus datos de Supabase
# Project Settings -> API en tu proyecto de Supabase

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Envío de correo (opcional). Sin estas dos, el botón "Enviar por correo"
# avisa que falta configurarlo; el resto de la app funciona igual.
# Consíguelas en resend.com (plan gratis: 3.000 correos/mes)
RESEND_API_KEY=re_tu_api_key
RESEND_FROM=Tu Empresa <facturacion@tudominio.com>
